# Copy this file to .env and fill in your values.
# SITE_URL is used by Astro for canonical URLs and sitemap generation.
# In GitHub Actions, set this as a repository variable or secret.
# Leave unset to fall back to https://sabililhaq.github.io
SITE_URL=https://sabililhaq.com

# Feature flags — set to "false" to hide that item from /labs
FEATURE_LAB_FILES=true
FEATURE_LAB_EXCALIDRAW=true
FEATURE_LAB_URL_SHORTENER=true
FEATURE_LAB_QR=true
FEATURE_LAB_CONSISTENT_HASHING=true
