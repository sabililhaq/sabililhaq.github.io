---
// No server-side logic needed — this is a pure client:load island, same
// pattern as QRGenerator. Nothing here touches a server at build/SSR time.
---

<div class="chat-widget">
    <div class="chat-topbar">
        <span class="nickname" id="nickname">connecting…</span>
        <button type="button" id="info-toggle" aria-expanded="false" aria-controls="info-panel">ⓘ</button>
    </div>

    <div id="info-panel" class="info-panel" hidden>
        <ul>
            <li><strong>For fun only</strong> — this is a small personal project, not intended for important or private communication.</li>
            <li><strong>Swearing filter</strong> — messages are automatically checked for configured swear words before being delivered.</li>
            <li><strong>Temporary chat</strong> — messages disappear after <span id="expiration-seconds">…</span> seconds.</li>
            <li><strong>Built with WebSockets</strong> — this chat is a small demonstration of real-time WebSocket communication.</li>
            <li>
                <strong>For developers</strong> — curious how it works? Open your browser's Network inspector, filter for WS,
                and watch the WebSocket connection. You can see messages travel between your browser and the server in real time.
            </li>
        </ul>
    </div>

    <ul id="messages" class="messages" aria-live="polite"></ul>

    <form id="composer" class="composer">
        <input
            id="message-input"
            type="text"
            placeholder="Say something…"
            autocomplete="off"
            maxlength="500"
        />
        <button type="submit">Send</button>
    </form>
    
    <p id="status" class="status" role="status"></p>
</div>

<style>
    .chat-widget {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        border: 1px solid #dde1e7;
        border-radius: 1rem;
        padding: 0.85rem;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .chat-topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .nickname {
        font-weight: 700;
        font-size: 0.98rem;
        color: #111827;
        line-height: 1.2;
    }
    #info-toggle {
        appearance: none;
        background: #f8fafc;
        border: 1px solid #d1d5db;
        border-radius: 9999px;
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        color: #111827;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
    }
    #info-toggle:hover,
    #info-toggle:focus-visible {
        background: #eff6ff;
        border-color: #93c5fd;
        outline: none;
    }
    .info-panel {
        position: relative;
        z-index: 1;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 0.85rem;
        padding: 0.85rem 1rem;
        font-size: 0.92rem;
        color: #374151;
    }
    .info-panel ul {
        margin: 0;
        padding-left: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }
    .messages {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 220px;
        max-height: 360px;
        overflow-y: auto;
    }
    .messages li {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem;
        padding: 0.75rem 0.85rem;
        border-radius: 0.85rem;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        font-size: 0.94rem;
    }
    .messages .who {
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
    }
    .messages span:last-child {
        color: #334155;
        word-break: break-word;
    }
    .composer {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.5rem;
    }
    .composer input {
        flex: 1;
        padding: 0.75rem 0.9rem;
        border: 1px solid #d1d5db;
        border-radius: 0.85rem;
        font-size: 0.95rem;
        color: #0f172a;
        background: #fff;
    }
    .composer input:focus {
        outline: none;
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.14);
    }
    .composer button {
        padding: 0 1rem;
        border: none;
        border-radius: 0.85rem;
        background: #111827;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .composer button:hover {
        background: #1f2937;
    }
    .composer button:disabled {
        background: #cbd5e1;
        cursor: not-allowed;
    }
    .status {
        min-height: 1.2em;
        font-size: 0.85rem;
        color: #b91c1c;
        margin: 0;
    }
    @media (max-width: 520px) {
        .chat-widget {
            padding: 0.85rem;
        }
        .chat-topbar {
            gap: 0.5rem;
        }
        .nickname {
            font-size: 0.92rem;
        }
        .composer input {
            min-width: 0;
        }
    }
</style>

<script>
    const WS_URL = (() => {
        try {
            const host = location.hostname;
            if (host === 'localhost' || host === '127.0.0.1') {
                const port = 8080;
                return `ws://${host}:${port}`;
            }
            return 'wss://ws.sabililhaq.com';
        } catch {
            return 'wss://ws.sabililhaq.com';
        }
    })();

    const nicknameEl = document.getElementById('nickname');
    const infoToggle = document.getElementById('info-toggle');
    const infoPanel = document.getElementById('info-panel');
    const expirationEl = document.getElementById('expiration-seconds');
    const messagesEl = document.getElementById('messages');
    const composer = document.getElementById('composer');
    const input = document.getElementById('message-input');
    const statusEl = document.getElementById('status');

    let expirationSeconds = 30;
    let ws = null;

    function renderMessage(msg) {
        const li = document.createElement('li');
        li.dataset.ts = String(msg.ts);
        li.dataset.id = msg.id;

        const who = document.createElement('span');
        who.className = 'who';
        who.textContent = msg.nickname + ':';

        const text = document.createElement('span');
        text.textContent = msg.text;

        li.append(who, text);
        messagesEl.appendChild(li);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function sweepExpired() {
        const cutoff = Date.now() - expirationSeconds * 1000;
        for (const li of Array.from(messagesEl.children)) {
            if (Number(li.dataset.ts) < cutoff) li.remove();
        }
    }
    setInterval(sweepExpired, 1000);

    function connect() {
        ws = new WebSocket(WS_URL);

        ws.addEventListener('open', () => {
            statusEl.textContent = '';
        });

        ws.addEventListener('message', (event) => {
            const data = JSON.parse(event.data);

            switch (data.type) {
                case 'welcome':
                    nicknameEl.textContent = data.nickname;
                    expirationSeconds = data.config.expirationSeconds;
                    expirationEl.textContent = String(expirationSeconds);
                    input.maxLength = data.config.maxMessageLength;
                    break;
                case 'backlog':
                    messagesEl.innerHTML = '';
                    for (const m of data.messages) renderMessage(m);
                    break;
                case 'message':
                    renderMessage(data.message);
                    break;
                case 'error':
                    statusEl.textContent = data.reason === 'rate_limited'
                        ? "You're sending messages too fast."
                        : 'Message not sent.';
                    break;
            }
        });

        ws.addEventListener('close', () => {
            nicknameEl.textContent = 'disconnected — reconnecting…';
            statusEl.textContent = '';
            setTimeout(connect, 1500);
        });

        ws.addEventListener('error', () => {
            if (ws) ws.close();
        });
    }

    if (infoToggle && infoPanel) {
        infoToggle.addEventListener('click', () => {
            const isOpen = infoPanel.hidden === false;
            infoPanel.hidden = isOpen;
            infoToggle.setAttribute('aria-expanded', String(!isOpen));
        });
    }

    composer.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = input.value.trim();
        if (!text || !ws || ws.readyState !== WebSocket.OPEN) return;
        ws.send(JSON.stringify({ text }));
        input.value = '';
    });

    connect();
</script>
