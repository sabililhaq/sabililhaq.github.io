---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="site-name">
			<a href="/">{SITE_TITLE}</a>
		</div>
		<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
			<svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
			</svg>
			<svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
			</svg>
		</button>
		<nav aria-label="Primary">
			<HeaderLink href="/projects">projects</HeaderLink>
			<span class="sep" aria-hidden="true">│</span>
			<HeaderLink href="/blog">blogs</HeaderLink>
			<span class="sep" aria-hidden="true">│</span>
			<HeaderLink href="/links">links</HeaderLink>
			<span class="sep" aria-hidden="true">│</span>
			<HeaderLink href="/labs">labs</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.3rem;
		background: rgb(var(--bg));
		box-sizing: border-box;
	}
	.theme-toggle {
		appearance: none;
		position: absolute;
		top: 1.15rem;
		right: 0;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		margin: 0;
		border: none;
		border-radius: 4px;
		background: none;
		color: rgb(var(--gray));
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: rgb(var(--black));
	}
	.theme-toggle svg {
		display: block;
	}
	.theme-toggle .icon-sun {
		display: none;
	}
	:global(html[data-theme='dark']) .theme-toggle .icon-moon {
		display: none;
	}
	:global(html[data-theme='dark']) .theme-toggle .icon-sun {
		display: block;
	}
	.header-inner {
		position: relative;
		width: 100%;
		max-width: var(--content-width);
		margin: 0 auto;
		padding-top: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
	}
	.site-name {
		font-size: 1.45rem;
		font-family: Georgia, 'Iowan Old Style', 'Palatino Linotype', Palatino, serif;
		font-weight: normal;
		margin-bottom: 0.65rem;
		padding: 0 2.25rem;
		letter-spacing: -0.01em;
	}
	.site-name a {
		text-decoration: none;
		color: rgb(var(--black));
	}
	.site-name a:hover {
		text-decoration: underline;
		text-underline-offset: 0.18em;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 100%;
		border-bottom: 1px solid rgb(var(--gray-light));
		padding: 0.35rem 0 0.7rem;
		gap: 0.7rem;
		flex-wrap: wrap;
		box-sizing: border-box;
	}
	.sep {
		color: rgb(var(--gray-light));
		user-select: none;
		font-size: 0.85rem;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1.15rem;
		}
		.site-name {
			font-size: 1.3rem;
		}
	}

	@media (max-width: 480px) {
		.site-name {
			font-size: 1.15rem;
		}

		nav {
			gap: 0.45rem;
			font-size: 0.9rem;
		}
	}
</style>

<script>
	const STORAGE_KEY = 'theme';
	const button = document.getElementById('theme-toggle');

	function currentTheme() {
		return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
	}

	function syncButton() {
		if (!(button instanceof HTMLButtonElement)) return;
		const next = currentTheme() === 'dark' ? 'light' : 'dark';
		button.setAttribute('aria-label', `Switch to ${next} mode`);
		button.setAttribute('aria-pressed', currentTheme() === 'dark' ? 'true' : 'false');
	}

	function applyTheme(theme: 'dark' | 'light') {
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem(STORAGE_KEY, theme);
		} catch {
			// Ignore private-mode storage failures.
		}
		syncButton();
	}

	button?.addEventListener('click', () => {
		applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
	});

	syncButton();
</script>
