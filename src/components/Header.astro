---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="site-name">
			<a href="/">{SITE_TITLE}</a>
		</div>
		<nav>
			<HeaderLink href="/about">about</HeaderLink>
			<span class="sep">|</span>
			<HeaderLink href="/blog">blogs</HeaderLink>
			<span class="sep">|</span>
			<HeaderLink href="/links">links</HeaderLink>
			<span class="sep">|</span>
			<HeaderLink href="/labs">labs</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
	}
	.header-inner {
		max-width: 720px;
		margin: 0 auto;
		padding-top: 1.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.site-name {
		font-size: 1.6rem;
		font-family: 'Georgia', 'Iowan Old Style', 'Palatino Linotype', Palatino, serif;
		font-weight: normal;
		margin-bottom: 0.5rem;
	}
	.site-name a {
		text-decoration: none;
		color: inherit;
	}
	.site-name a:hover {
		text-decoration: underline;
		color: inherit;
	}
	nav {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 100%;
		border-top: 1px solid rgb(var(--gray-light));
		border-bottom: 1px solid rgb(var(--gray-light));
		padding: 0.4rem 0;
		gap: 0.6rem;
	}
	.sep {
		color: rgb(var(--gray-light));
		user-select: none;
	}
	@media (max-width: 720px) {
		.site-name {
			font-size: 1.35rem;
		}
	}
</style>
