---
---

<div class="terbilang">
	<div class="field">
		<label for="tb-input">Number</label>
		<input
			id="tb-input"
			type="text"
			inputmode="decimal"
			placeholder="1.250.000"
			autocomplete="off"
			spellcheck="false"
		/>
	</div>

	<div class="examples">
		<button type="button" data-example="11">11</button>
		<button type="button" data-example="1000">1.000</button>
		<button type="button" data-example="15000">15.000</button>
		<button type="button" data-example="1250000">1.250.000</button>
		<button type="button" data-example="1945">1945</button>
	</div>

	<label class="check">
		<input type="checkbox" id="tb-rupiah" />
		Read as rupiah
	</label>

	<p class="hint" id="tb-hint">Type a number, or pick an example.</p>
	<p class="error" id="tb-error" hidden></p>

	<div class="output" id="tb-output" hidden>
		<div class="words-box">
			<p id="tb-words"></p>
			<button type="button" id="tb-copy">Copy</button>
		</div>
		<p class="formatted" id="tb-formatted"></p>
	</div>
</div>

<style>
	.terbilang {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.field label {
		font-size: 0.875rem;
		font-weight: 500;
	}

	.field input[type='text'] {
		padding: 0.65rem 0.75rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		font-size: 1rem;
		font-family: inherit;
		background: rgb(var(--bg));
		color: rgb(var(--gray-dark));
		box-sizing: border-box;
		width: 100%;
	}

	.field input[type='text']:focus {
		outline: none;
		border-color: rgb(var(--black));
	}

	.examples {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.examples button {
		padding: 0.3rem 0.7rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: rgb(var(--surface));
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		font-family: inherit;
		cursor: pointer;
	}

	.examples button:hover {
		border-color: rgb(var(--black));
		color: rgb(var(--black));
	}

	.check {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		width: fit-content;
	}

	.check input {
		accent-color: rgb(var(--black));
	}

	.hint,
	.error,
	.formatted {
		margin: 0;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.error {
		color: #b42318;
	}

	:global(html[data-theme='dark']) .error {
		color: #f97066;
	}

	.words-box {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.15rem 1.2rem;
		background: rgb(var(--surface));
		border-radius: 12px;
	}

	.words-box p {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.45;
		color: rgb(var(--black));
	}

	.words-box button {
		align-self: flex-start;
		padding: 0.5rem 1rem;
		border: none;
		border-radius: 8px;
		font-size: 0.9rem;
		font-weight: 500;
		font-family: inherit;
		cursor: pointer;
		background: rgb(var(--black));
		color: rgb(var(--bg));
	}

	.words-box button:hover {
		opacity: 0.85;
	}

	.output {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}
</style>

<script>
	import {
		formatId,
		parseNumberInput,
		sentenceCase,
		toTerbilang,
	} from './terbilang';

	const input = document.getElementById('tb-input');
	const rupiah = document.getElementById('tb-rupiah');
	const hint = document.getElementById('tb-hint');
	const error = document.getElementById('tb-error');
	const output = document.getElementById('tb-output');
	const words = document.getElementById('tb-words');
	const formatted = document.getElementById('tb-formatted');
	const copy = document.getElementById('tb-copy');
	const examples = document.querySelector('.examples');

	async function copyText(text: string): Promise<boolean> {
		if (navigator.clipboard?.writeText) {
			try {
				await navigator.clipboard.writeText(text);
				return true;
			} catch {
				// fall through
			}
		}

		const textarea = document.createElement('textarea');
		textarea.value = text;
		textarea.setAttribute('readonly', '');
		textarea.style.position = 'fixed';
		textarea.style.left = '-9999px';
		document.body.appendChild(textarea);
		textarea.select();
		const ok = document.execCommand('copy');
		textarea.remove();
		return ok;
	}

	function setHidden(el: HTMLElement | null, hidden: boolean) {
		if (!el) return;
		el.hidden = hidden;
	}

	function currentOptions() {
		return { rupiah: rupiah instanceof HTMLInputElement && rupiah.checked };
	}

	function render() {
		if (!(input instanceof HTMLInputElement)) return;

		const parsed = parseNumberInput(input.value);
		if (!parsed.ok && parsed.reason === 'empty') {
			setHidden(hint, false);
			setHidden(error, true);
			setHidden(output, true);
			return;
		}

		setHidden(hint, true);

		if (!parsed.ok) {
			if (error) {
				error.textContent =
					parsed.reason === 'too-large' ? 'That number is too large.' : "Can't parse that.";
			}
			setHidden(error, false);
			setHidden(output, true);
			return;
		}

		const options = currentOptions();
		const reading = sentenceCase(toTerbilang(parsed.value, options));
		if (words) words.textContent = reading;
		if (formatted) formatted.textContent = formatId(parsed.value, options);
		setHidden(error, true);
		setHidden(output, false);
	}

	input?.addEventListener('input', render);
	rupiah?.addEventListener('change', render);

	examples?.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLButtonElement)) return;
		const example = target.dataset.example;
		if (!example || !(input instanceof HTMLInputElement)) return;
		input.value = target.textContent?.trim() || example;
		input.focus();
		render();
	});

	let reset: number | undefined;
	copy?.addEventListener('click', async () => {
		const text = words?.textContent ?? '';
		if (!text) return;
		if (!(await copyText(text))) return;
		if (!(copy instanceof HTMLButtonElement)) return;
		copy.textContent = 'Copied';
		window.clearTimeout(reset);
		reset = window.setTimeout(() => {
			copy.textContent = 'Copy';
		}, 1600);
	});

	render();
</script>
