---
// Client-side only
---

<div class="qr-generator">
  <!-- Input -->
  <div class="field">
    <label for="qr-input">Text / URL</label>
    <textarea
      id="qr-input"
      rows="3"
      placeholder="https://sabililhaq.com"
    ></textarea>
  </div>

  <!-- Options -->
  <div class="options">
    <div class="field">
      <label for="qr-size">Size (px)</label>
      <input id="qr-size" type="number" value="300" min="100" max="1000" />
    </div>

    <div class="field">
      <label for="qr-ec">Error Correction</label>
      <select id="qr-ec">
        <option value="L">Low (L)</option>
        <option value="M" selected>Medium (M)</option>
        <option value="Q">Quartile (Q)</option>
        <option value="H">High (H)</option>
      </select>
    </div>

    <div class="field">
      <label for="qr-color">Color</label>
      <input id="qr-color" type="color" value="#000000" />
    </div>
  </div>

  <!-- Preview -->
  <div class="preview">
    <div id="qr-code"></div>
  </div>

  <!-- Actions -->
  <div class="actions">
    <button id="download-png">Download PNG</button>
    <button id="download-svg" class="secondary">Download SVG</button>
  </div>
</div>

<style>
  .qr-generator {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .field textarea,
  .field input[type="number"],
  .field select {
    padding: 0.65rem 0.75rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    background: rgb(var(--bg));
    color: rgb(var(--gray-dark));
  }

  .field textarea:focus,
  .field input:focus,
  .field select:focus {
    border-color: rgb(var(--black));
  }

  .field input[type="color"] {
    height: 42px;
    padding: 4px;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 8px;
    cursor: pointer;
  }

  .options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .options {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .preview {
    display: flex;
    justify-content: center;
    padding: 1.5rem;
    background: rgb(var(--surface));
    border-radius: 12px;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .actions button {
    padding: 0.65rem 1.25rem;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    background: rgb(var(--black));
    color: rgb(var(--bg));
  }

  .actions button:hover {
    opacity: 0.85;
  }

  .actions button.secondary {
    background: rgb(var(--gray-dark));
  }
</style>

<script>
  import QRCodeStyling from "qr-code-styling";

  const qrCode = new QRCodeStyling({
    width: 300,
    height: 300,
    type: "svg",
    data: "https://sabililhaq.com",
    dotsOptions: {
      color: "#000000",
      type: "rounded"
    },
    backgroundOptions: {
      color: "#ffffff",
    },
    qrOptions: {
      errorCorrectionLevel: "M"
    }
  });

  function requireEl<T extends HTMLElement>(
    id: string,
    ctor: { new (): T } | (new (...args: never[]) => T),
  ): T {
    const el = document.getElementById(id);
    if (!(el instanceof ctor)) {
      throw new Error(`QR generator markup is missing #${id}`);
    }
    return el;
  }

  const input = requireEl("qr-input", HTMLTextAreaElement);
  const sizeInput = requireEl("qr-size", HTMLInputElement);
  const ecSelect = requireEl("qr-ec", HTMLSelectElement);
  const colorInput = requireEl("qr-color", HTMLInputElement);
  const container = requireEl("qr-code", HTMLElement);
  const downloadPng = requireEl("download-png", HTMLButtonElement);
  const downloadSvg = requireEl("download-svg", HTMLButtonElement);

  qrCode.append(container);

  function updateQR() {
    const data = input.value.trim() || "https://sabililhaq.com";
    const size = parseInt(sizeInput.value, 10) || 300;
    const color = colorInput.value;
    const ec = ecSelect.value as "L" | "M" | "Q" | "H";

    qrCode.update({
      width: size,
      height: size,
      data: data,
      dotsOptions: { color },
      qrOptions: { errorCorrectionLevel: ec }
    });
  }

  input.addEventListener("input", updateQR);
  sizeInput.addEventListener("input", updateQR);
  ecSelect.addEventListener("change", updateQR);
  colorInput.addEventListener("input", updateQR);

  downloadPng.addEventListener("click", () => {
    qrCode.download({ name: "qr-code", extension: "png" });
  });

  downloadSvg.addEventListener("click", () => {
    qrCode.download({ name: "qr-code", extension: "svg" });
  });
</script>
