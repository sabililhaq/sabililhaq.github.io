---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CopyCode from '../components/CopyCode.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				font-size: 16px;
			}
			.prose {
				width: 100%;
				max-width: 720px;
				margin: auto;
				color: rgb(var(--gray-dark));
				box-sizing: border-box;
			}
			.prose :global(p) {
				margin-bottom: 1em;
				font-size: 1em;
			}
			.hero-image {
				margin-bottom: 1.5rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 12px;
			}
			.title {
				margin-bottom: 1.5rem;
			}
			.title h1 {
				margin: 0 0 0.4rem;
				font-size: 1.4rem;
			}
			.date {
				margin-bottom: 0.35rem;
				color: rgb(var(--gray));
				font-size: 0.85rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(figure) {
				margin: 0 0 1.5em;
			}
			.prose :global(figcaption) {
				margin-top: 0.5rem;
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			/* Sean-style footnote links: underline the word, jump to notes, jump back */
			.prose :global(a) {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 0.15em;
			}
			.prose :global(a:hover) {
				text-decoration-thickness: 2px;
			}
			.prose :global(hr) {
				border: none;
				border-top: 1px solid rgb(var(--gray-light));
				margin: 2em 0 1.25em;
			}
			.prose :global(ol.footnotes) {
				margin: 0 0 1.5em;
				padding-left: 1.4em;
				color: rgb(var(--gray-dark));
				font-size: 0.92em;
			}
			.prose :global(ol.footnotes li) {
				margin-bottom: 0.75em;
			}
			.prose :global(a.footnote-backref) {
				text-decoration: none;
				margin-left: 0.15em;
			}
			.prose :global(a.footnote-backref:hover) {
				text-decoration: underline;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<CopyCode />
	</body>
</html>
