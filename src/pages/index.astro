---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { LABS, MEDIUM_POSTS, SITE_DESCRIPTION, SITE_SHORT_NAME, SITE_TITLE } from '../consts';

const localPosts = (await getCollection('blog')).map((post) => ({
	title: post.data.title,
	url: `/${post.id}/`,
	pubDate: post.data.pubDate,
}));

const posts = [...localPosts, ...MEDIUM_POSTS]
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
	.slice(0, 1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm {SITE_SHORT_NAME}</h1>
				<p>
					I'm a Software Engineer, currently doing backend and distributed systems stuff @ Samsung Indonesia.
					I enjoy building products and being part of the full engineering process.
				</p>
				<p>
					I treat this site as my personal playground and showcase.
					Check <a href="/labs">labs</a> for random stuff i deployed,
					or look around my <a href="/projects">projects</a> and <a href="/blog">blog</a>.
				</p>
				<p class="intro-links">
					<a href="/about">More about me →</a>
				</p>
			</section>

			<section class="labs">
				<h2>Labs</h2>
				<ul class="hover-list lab-list">
					{LABS.map((lab) => (
						<li>
							<a
								href={lab.url}
								target={lab.url.startsWith('http') ? '_blank' : undefined}
								rel={lab.url.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								{lab.label}
							</a>
							{lab.description && <span class="desc"> — {lab.description}</span>}
						</li>
					))}
				</ul>
			</section>

			{posts.length > 0 && (
				<section class="recent-posts">
					<h2>Recent posts</h2>
					<ul class="hover-list">
						{posts.map((post) => (
							<li>
								<a
									href={post.url}
									target={post.url.startsWith('http') ? '_blank' : undefined}
									rel={post.url.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{post.title}
								</a>
								<div class="post-date"><FormattedDate date={post.pubDate} /></div>
							</li>
						))}
					</ul>
					<a class="all-posts" href="/blog">All posts →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-bottom: 2.75rem;
		padding-top: 1.25rem;
	}

	.intro h1 {
		font-size: 1.5rem;
		margin-bottom: 0.85rem;
		letter-spacing: -0.02em;
	}

	.intro p {
		margin-bottom: 1rem;
		color: rgb(var(--gray-dark));
	}

	.intro-links {
		margin-top: 0.35rem;
	}

	.intro-links a {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		text-decoration: none;
		box-shadow: none;
	}

	.intro-links a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.labs,
	.recent-posts {
		margin-bottom: 2.5rem;
	}

	.labs h2,
	.recent-posts h2 {
		font-size: 1.05rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.85rem;
	}

	.lab-list a,
	.recent-posts li a {
		color: var(--accent);
		text-decoration: none;
		box-shadow: 0 1px 0 0 currentColor;
		font-weight: 700;
	}

	.lab-list a:hover,
	.recent-posts li a:hover {
		box-shadow: none;
	}

	.lab-list {
		margin: 0;
	}

	.desc {
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}

	.recent-posts ul {
		margin: 0 0 1rem;
	}

	.all-posts {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.all-posts:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.post-date {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		margin-top: 0.2rem;
	}
</style>
