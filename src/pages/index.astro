---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { PROJECTS, MEDIUM_POSTS, SITE_DESCRIPTION, SITE_SHORT_NAME, SITE_TITLE } from '../consts';

const localPosts = (await getCollection('blog')).map((post) => ({
	title: post.data.title,
	url: `/${post.id}/`,
	pubDate: post.data.pubDate,
}));
const posts = [...localPosts, ...MEDIUM_POSTS]
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
	.slice(0, 2);
const featuredProjects = ['geoproximity', 'vim-dojo']
	.map((id) => PROJECTS.find((project) => project.id === id))
	.filter((project) => project != null);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm {SITE_SHORT_NAME}</h1>
				<p>
					I'm a Software Engineer, currently doing backend and distributed systems stuff @ Samsung Indonesia.
					I enjoy building products and being part of the full engineering process.
				</p>
				<p>
					I treat this site as my personal playground and showcase.
					Check <a href="/labs">labs</a> for random stuff i deployed,
					or look around my <a href="/projects">projects</a> and <a href="/blog">blog</a>.
				</p>
				<p class="intro-links">
					<a href="/about">About me →</a>
				</p>
			</section>

			<section class="featured-projects">
				<h2>Featured projects</h2>
				<div class="project-grid">
					{featuredProjects.map((project) => (
						<article>
							{project.image && project.liveDemo && (
								<a class="project-preview" href={project.liveDemo} aria-label={`Try ${project.title}`} data-project={project.id}>
									<Image src={project.image} alt={project.imageAlt ?? project.title}
									widths={[320, 640, 960, 1280].filter((width) => width <= project.image!.width)}
                                    sizes="(max-width: 480px) calc(100vw - 2rem), (max-width: 672px) calc((100vw - 4.1rem) / 2), 296px"
                                    format="webp" quality={85}
									loading="lazy" decoding="async" />
									</a>
							)}
							<h3>{project.title}</h3>
							<p class="desc">{project.id === 'geoproximity'
								? 'Compare places by distance to a destination, all on one map.'
								: 'Practice Vim with small coding challenges in your browser.'}</p>
							<p class="project-links">
								{project.liveDemo && <a href={project.liveDemo} aria-label={`Try ${project.title}`}>Try it →</a>}
							</p>
						</article>
					))}
				</div>
				<p><a class="more-link" href="/projects">All projects →</a></p>
			</section>

			{posts.length > 0 && (
				<section class="recent-posts">
					<h2>Latest writing</h2>
					<ul class="hover-list">
						{posts.map((post) => (
							<li>
								<a href={post.url}
									target={post.url.startsWith('http') ? '_blank' : undefined}
									rel={post.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
									{post.title}
								</a>
								<div class="post-date"><FormattedDate date={post.pubDate} /></div>
							</li>
						))}
					</ul>
					<a class="more-link" href="/blog">All posts →</a>
				</section>
			)}

			<section class="labs">
				<h2>Playground</h2>
				<p class="desc">Smaller experiments: a <a href="/qr">QR generator</a>,
					<a href="/poster">map posters</a>, and <a href="/chat">bad-word chat filter</a>.</p>
				<a class="more-link" href="/labs">All labs →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section { margin-bottom: 2.5rem; }
	.intro { padding-top: 1.25rem; }
	.intro h1 { font-size: 1.5rem; margin-bottom: 0.85rem; }
	h2 { font-size: 1.05rem; margin-bottom: 1rem; }
	.intro-links, .project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		font-size: 0.95rem;
	}
	.intro-links a { box-shadow: none; }
	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.project-preview { display: block; border-radius: 4px; }
	.project-preview img { object-position: center center; }
	.project-grid img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--gray-light));
		box-sizing: border-box;
		margin-bottom: 0.85rem;
	}
	.project-links { margin: 0.65rem 0 0; }
	.desc {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0.35rem 0 0;
	}
	.recent-posts ul { margin-bottom: 1rem; }
	.recent-posts li a { font-weight: 700; }
	.post-date { color: rgb(var(--gray)); font-size: 0.9rem; margin-top: 0.2rem; }
	.labs .desc { margin-bottom: 0.75rem; }
	.more-link { color: rgb(var(--gray)); font-size: 0.95rem; }
	a { text-decoration: none; }
	a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
	@media (max-width: 480px) {
		.project-grid { grid-template-columns: 1fr; }
	}
</style>
