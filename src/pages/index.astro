---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { LABS, MEDIUM_POSTS, SITE_DESCRIPTION, SITE_SHORT_NAME, SITE_TITLE } from '../consts';

const localPosts = (await getCollection('blog')).map((post) => ({
	title: post.data.title,
	url: `/${post.id}/`,
	pubDate: post.data.pubDate,
}));

const posts = [...localPosts, ...MEDIUM_POSTS]
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
	.slice(0, 1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>Hi, I'm <span class="name">{SITE_SHORT_NAME}</span></h1>
				<p>
					I'm a Software Engineer, currently doing backend and distributed systems stuff @ Samsung Indonesia.
					I enjoy building products and being part of the full engineering process.
					<br><br>
					I treat this site as my personal playground and showcase.
					Check <a href="/labs">labs</a> for random stuff i deployed,
					or look around my <a href="/projects">projects</a> and <a href="/blog">blogs</a>.
				</p>
				<p class="intro-links">
					<a href="/about">More about me →</a>
				</p>
			</section>

			<section class="labs">
				<h2>Labs</h2>
				<p class="lab-names">
					{LABS.map((lab, index) => (
						<>
							{index > 0 && <span class="dot"> · </span>}
							<a
								href={lab.url}
								target={lab.url.startsWith('http') ? '_blank' : undefined}
								rel={lab.url.startsWith('http') ? 'noopener noreferrer' : undefined}
							>
								{lab.label}
							</a>
						</>
					))}
				</p>
			</section>

			{posts.length > 0 && (
				<section class="recent-posts">
					<h2>Recent posts</h2>
					<ul>
						{posts.map((post) => (
							<li>
								<a
									href={post.url}
									target={post.url.startsWith('http') ? '_blank' : undefined}
									rel={post.url.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{post.title}
								</a>
								<span class="post-date"><FormattedDate date={post.pubDate} /></span>
							</li>
						))}
					</ul>
					<a class="all-posts" href="/blog">All posts →</a>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 680px;
	}

	.intro {
		margin-bottom: 2.5rem;
		padding-top: 2rem;
	}

	.intro h1 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.name {
		color: var(--accent);
	}

	.intro p {
		margin-bottom: 0.75rem;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		line-height: 1.65;
	}

	.intro-links a {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.intro-links a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.labs,
	.recent-posts {
		margin-bottom: 2.25rem;
	}

	.labs h2,
	.recent-posts h2 {
		font-size: 1rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
		margin-bottom: 0.75rem;
		border-bottom: none;
	}

	.lab-names a,
	.recent-posts li a {
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 600;
	}

	.lab-names a:hover,
	.recent-posts li a:hover {
		text-decoration: underline;
		color: var(--accent);
	}

	.lab-names {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.dot {
		color: rgb(var(--gray-light));
		font-weight: 400;
	}

	.recent-posts ul {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
	}

	.recent-posts li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		font-size: 0.95rem;
	}

	.all-posts {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		text-decoration: none;
		font-weight: 400;
	}

	.all-posts:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.post-date {
		color: rgb(var(--gray));
		font-size: 0.8rem;
		white-space: nowrap;
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.intro h1 {
			font-size: 1.25rem;
		}

		.recent-posts li {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}

		.post-date {
			font-size: 0.75rem;
		}
	}
</style>
