---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { MEDIUM_POSTS, SITE_SHORT_NAME, SITE_TITLE, SOCIALS } from '../../consts';

const localPosts = (await getCollection('blog'))
	.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		url: `/${post.id}/`,
		pubDate: post.data.pubDate,
	}))
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const mediumPosts = [...MEDIUM_POSTS].sort(
	(a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description={`Writing by ${SITE_SHORT_NAME}.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1 class="page-title">Blog</h1>

				{
					localPosts.length > 0 && (
						<section class="group">
							<ul class="post-list hover-list">
								{localPosts.map((post) => (
									<li>
										<a href={post.url}>{post.title}</a>
										<div class="meta">
											<FormattedDate date={post.pubDate} />
										</div>
										{post.description && <p class="desc">{post.description}</p>}
									</li>
								))}
							</ul>
						</section>
					)
				}

				<section class="group archive">
					<h2>Earlier on Medium</h2>
					<ul class="post-list hover-list">
						{
							mediumPosts.map((post) => (
								<li>
									<a href={post.url} target="_blank" rel="noopener noreferrer">
										{post.title}
									</a>
									<div class="meta">
										<FormattedDate date={post.pubDate} />
									</div>
									{post.description && <p class="desc">{post.description}</p>}
								</li>
							))
						}
					</ul>
					<p class="more">
						<a href={SOCIALS.medium} target="_blank" rel="noopener noreferrer">
							More on Medium →
						</a>
					</p>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.group {
		margin-bottom: 2.75rem;
	}

	.group h2 {
		font-size: 1.05rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 1.15rem;
		padding-top: 0.25rem;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.archive h2 {
		font-size: 0.95rem;
		font-weight: 600;
		color: rgb(var(--gray));
	}

	.archive .post-list a {
		font-size: 1.05rem;
		font-weight: 600;
	}

	.post-list a {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		box-shadow: 0 1px 0 0 currentColor;
		line-height: 1.35;
	}

	.post-list a:hover,
	.post-list a:active {
		box-shadow: none;
	}

	.meta {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		margin-top: 0.3rem;
	}

	.desc {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0.35rem 0 0;
	}

	.more {
		margin: 0.5rem 0 0;
	}

	.more a {
		font-size: 0.95rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.more a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
</style>
