---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { MEDIUM_POSTS, SITE_SHORT_NAME, SITE_TITLE, SOCIALS } from '../../consts';

const localPosts = (await getCollection('blog'))
	.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		url: `/${post.id}/`,
		pubDate: post.data.pubDate,
	}))
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const mediumPosts = [...MEDIUM_POSTS].sort(
	(a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description={`Writing by ${SITE_SHORT_NAME}.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h3>Blog</h3>

				{
					localPosts.length > 0 && (
						<section class="group">
							<h2>Here</h2>
							<ul class="post-list">
								{localPosts.map((post) => (
									<li>
										<div class="post-row">
											<a href={post.url}>{post.title}</a>
											<span class="date">
												<FormattedDate date={post.pubDate} />
											</span>
										</div>
										{post.description && <span class="desc">{post.description}</span>}
									</li>
								))}
							</ul>
						</section>
					)
				}

				<section class="group">
					<h2>On Medium</h2>
					<ul class="post-list">
						{
							mediumPosts.map((post) => (
								<li>
									<div class="post-row">
										<a href={post.url} target="_blank" rel="noopener noreferrer">
											{post.title}
										</a>
										<span class="date">
											<FormattedDate date={post.pubDate} />
										</span>
									</div>
									{post.description && <span class="desc">{post.description}</span>}
								</li>
							))
						}
					</ul>
					<p class="more">
						<a href={SOCIALS.medium} target="_blank" rel="noopener noreferrer">
							More on Medium →
						</a>
					</p>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		font-size: 16px;
	}

	.prose h3 {
		font-size: 1.35rem;
		margin-bottom: 1.25rem;
	}

	.group {
		margin-bottom: 2.25rem;
	}

	.group h2 {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
		margin: 0 0 1rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.post-list li {
		position: relative;
		isolation: isolate;
		font-size: 0.95rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 0.85rem;
	}

	.post-list li:last-child {
		border-bottom: none;
	}

	.post-list li::before {
		content: "";
		position: absolute;
		z-index: -1;
		inset: 0 0 0.85rem;
		background-color: rgb(var(--row-hover));
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}

	.post-list li:hover::before {
		opacity: 1;
	}

	.post-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.post-list a {
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
	}

	.post-list a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.post-list a:hover {
		text-decoration: underline;
		color: var(--accent);
	}

	.date {
		color: rgb(var(--gray));
		font-size: 0.8rem;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.desc {
		display: block;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		margin-top: 0.2rem;
	}

	.more {
		margin: 1rem 0 0;
	}

	.more a {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		text-decoration: none;
		font-weight: 400;
	}

	.more a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	@media (max-width: 640px) {
		.post-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
		}
	}
</style>
