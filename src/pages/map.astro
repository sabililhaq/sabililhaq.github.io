---
import BaseHead from '../components/BaseHead.astro';
import FocusMode from '../components/FocusMode.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" class="map-lab focus-mode">
  <head>
    <link rel="preconnect" href="https://a.basemaps.cartocdn.com" />
    <BaseHead
      title={`Map | ${SITE_TITLE}`}
      description="Rank places by distance."
    />
  </head>
  <body>
    <Header />
    <main>
      <div data-map-stage>
        <div id="map-proximity-host" data-proximity-host></div>
      </div>
    </main>
    <Footer />
    <FocusMode />
  </body>
</html>

<style is:global>
  html.map-lab,
  html.map-lab body {
    height: 100%;
    height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }

  html.map-lab body {
    display: flex;
    flex-direction: column;
  }

  html.map-lab body > header {
    flex-shrink: 0;
  }

  html.map-lab body > main {
    flex: 1 1 0%;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  html.map-lab body > footer {
    flex-shrink: 0;
    padding: 0.75rem 1.3rem;
  }

  html.map-lab [data-map-stage] {
    flex: 1 1 0%;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  html.map-lab [data-proximity-host] {
    flex: 1 1 0%;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 0;
  }

  /* ── Focus mode: collapse header + footer ──────────────────────── */
  html.map-lab.focus-mode body > header,
  html.map-lab.focus-mode body > footer {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    max-height: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    overflow: hidden;
    transition: max-height 0.22s ease, opacity 0.18s ease, visibility 0.18s;
  }
</style>

<script>
  import { posterRedirectPath } from '../map/poster-redirect';

  const next = posterRedirectPath(location.search, location.hash);
  if (next) {
    location.replace(next);
  } else {
    const host = document.querySelector('[data-proximity-host]');
    if (host instanceof HTMLElement) {
      const { mountProximity, invalidateProximity } = await import('geoproximity');
      mountProximity(host, {
        basePath: '/map',
        sample: true,
        share: true,
        cartoApiKey: import.meta.env.PUBLIC_CARTO_API_KEY,
      });
      requestAnimationFrame(() => {
        window.dispatchEvent(new Event('resize'));
        invalidateProximity(host);
      });
    }
  }
</script>
