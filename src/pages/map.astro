---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" class="map-lab">
  <head>
    <BaseHead
      title={`Map | ${SITE_TITLE}`}
      description="Rank places by distance, or style a map poster."
    />
  </head>
  <body>
    <Header />
    <main>
      <div data-map-stage>
        <div class="map-mode-bar">
          <div class="map-mode-toggle" role="tablist" aria-label="Map mode">
            <button type="button" role="tab" data-map-mode="proximity" aria-selected="true" aria-controls="map-proximity-host">Proximity</button>
            <button type="button" role="tab" data-map-mode="art" aria-selected="false" aria-controls="map-art-host">Poster</button>
          </div>
        </div>
        <div id="map-art-host" data-art-host role="tabpanel" aria-label="Poster map" hidden></div>
        <div id="map-proximity-host" data-proximity-host role="tabpanel" aria-label="Proximity map"></div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  html.map-lab,
  html.map-lab body {
    height: 100%;
    height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }

  html.map-lab body {
    display: flex;
    flex-direction: column;
  }

  html.map-lab body > header {
    flex-shrink: 0;
  }

  html.map-lab body > main {
    flex: 1 1 0%;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  html.map-lab body > footer {
    flex-shrink: 0;
    padding: 0.75rem 1.3rem;
  }

  html.map-lab .map-mode-bar {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    display: flex;
    justify-content: center;
    width: max-content;
    padding: 0;
    pointer-events: none;
    background: transparent;
  }

  html.map-lab .map-mode-toggle {
    display: inline-flex;
    padding: 3px;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 999px;
    background: color-mix(in srgb, rgb(var(--surface)) 92%, transparent);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
    pointer-events: auto;
  }

  html.map-lab .map-mode-toggle button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: rgb(var(--gray));
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.32rem 0.95rem;
    cursor: pointer;
  }

  html.map-lab .map-mode-toggle button[aria-selected='true'] {
    background: rgb(var(--black));
    color: rgb(var(--bg));
  }

  html.map-lab [data-map-stage] {
    flex: 1 1 0%;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  html.map-lab [data-art-host],
  html.map-lab [data-proximity-host] {
    flex: 1 1 0%;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 0;
  }

  html.map-lab [data-art-host][hidden],
  html.map-lab [data-proximity-host][hidden] {
    display: none !important;
  }

  html.map-lab [data-cartis] aside,
  html.map-lab [data-cartis] .sheet-panel {
    background: rgb(var(--bg));
  }

  html.map-lab [data-cartis] .input-field {
    background: rgb(var(--surface));
  }

  html.map-lab[data-theme='dark'] [data-cartis] aside .text-slate-900,
  html.map-lab[data-theme='dark'] [data-cartis] aside .text-slate-800,
  html.map-lab[data-theme='dark'] [data-cartis] aside .text-slate-700,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .text-slate-900,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .text-slate-800,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .text-slate-700 {
    color: rgb(var(--black));
  }

  html.map-lab[data-theme='dark'] [data-cartis] aside .text-slate-500,
  html.map-lab[data-theme='dark'] [data-cartis] aside .text-slate-400,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .text-slate-500,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .text-slate-400 {
    color: rgb(var(--gray));
  }

  html.map-lab[data-theme='dark'] [data-cartis] aside .bg-white,
  html.map-lab[data-theme='dark'] [data-cartis] aside .bg-white\/95,
  html.map-lab[data-theme='dark'] [data-cartis] aside .bg-slate-50,
  html.map-lab[data-theme='dark'] [data-cartis] aside .bg-slate-50\/50,
  html.map-lab[data-theme='dark'] [data-cartis] aside .bg-slate-100,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .bg-white,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .bg-slate-50,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .bg-slate-50\/50,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .bg-slate-100 {
    background-color: rgb(var(--surface));
    color: rgb(var(--gray-dark));
  }

  html.map-lab[data-theme='dark'] [data-cartis] aside .border-slate-100,
  html.map-lab[data-theme='dark'] [data-cartis] aside .border-slate-200,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .border-slate-100,
  html.map-lab[data-theme='dark'] [data-cartis] .sheet-panel .border-slate-200 {
    border-color: rgb(var(--gray-light));
  }
</style>

<script>
  import { parseMapMode, searchWithMode, type MapMode } from '../map/mode';

  const stageArt = document.querySelector('[data-art-host]');
  const stagePx = document.querySelector('[data-proximity-host]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-map-mode]');

  let artMounted = false;
  let pxMounted = false;
  let invalidatePx: ((root: HTMLElement) => void) | null = null;
  let applySeq = 0;
  const artFontsHref =
    'https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@400;700&family=Cormorant+Garamond:wght@600&family=Dancing+Script:wght@400;700&family=Inter:wght@400;700&family=Lora:wght@400;700&family=Merriweather:wght@400;700&family=Montserrat:wght@400;700&family=Open+Sans:wght@400;700&family=Outfit:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,700;1,700&family=Raleway:wght@400;700&family=Roboto:wght@400;700&family=Source+Code+Pro:wght@400;700&display=swap';

  function ensureArtFonts() {
    if (document.querySelector('[data-map-art-fonts]')) return;
    const preconnect = document.createElement('link');
    preconnect.rel = 'preconnect';
    preconnect.href = 'https://fonts.googleapis.com';
    const preconnectStatic = document.createElement('link');
    preconnectStatic.rel = 'preconnect';
    preconnectStatic.href = 'https://fonts.gstatic.com';
    preconnectStatic.crossOrigin = 'anonymous';
    const sheet = document.createElement('link');
    sheet.rel = 'stylesheet';
    sheet.href = artFontsHref;
    sheet.dataset.mapArtFonts = '';
    document.head.append(preconnect, preconnectStatic, sheet);
  }

  function currentMode(): MapMode {
    return parseMapMode(new URLSearchParams(location.search).get('mode'));
  }

  function syncButtons(mode: MapMode) {
    buttons.forEach((btn) => {
      const on = btn.dataset.mapMode === mode;
      btn.setAttribute('aria-selected', on ? 'true' : 'false');
      btn.tabIndex = on ? 0 : -1;
    });
  }

  function activateButton(btn: HTMLButtonElement) {
    btn.focus();
    void applyMode(parseMapMode(btn.dataset.mapMode));
  }

  async function applyMode(mode: MapMode, writeUrl = true) {
    if (!(stageArt instanceof HTMLElement) || !(stagePx instanceof HTMLElement)) return;
    const seq = ++applySeq;

    if (writeUrl) {
      const next = `${location.pathname}${searchWithMode(location.search, mode)}${location.hash}`;
      history.replaceState({}, '', next);
    }

    const art = mode === 'art';
    stageArt.hidden = !art;
    stagePx.hidden = art;
    stageArt.inert = !art;
    stagePx.inert = art;
    syncButtons(mode);

    if (art) {
      if (!artMounted) {
        ensureArtFonts();
        const { mountCartis } = await import('cartis');
        if (seq !== applySeq) return;
        mountCartis(stageArt, { basePath: '/map' });
        artMounted = true;
      }
    } else if (!pxMounted) {
      const { mountProximity, invalidateProximity } = await import('geoproximity');
      if (seq !== applySeq) return;
      mountProximity(stagePx, { basePath: '/map', sample: true });
      invalidatePx = invalidateProximity;
      pxMounted = true;
    } else {
      invalidatePx?.(stagePx);
    }

    requestAnimationFrame(() => {
      window.dispatchEvent(new Event('resize'));
      if (!art) invalidatePx?.(stagePx);
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      void applyMode(parseMapMode(btn.dataset.mapMode));
    });
    btn.addEventListener('keydown', (event) => {
      const index = Array.from(buttons).indexOf(btn);
      let nextIndex: number | null = null;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index - 1 + buttons.length) % buttons.length;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % buttons.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = buttons.length - 1;
      if (nextIndex === null) return;
      event.preventDefault();
      activateButton(buttons[nextIndex]);
    });
  });

  void applyMode(currentMode(), false);
</script>
