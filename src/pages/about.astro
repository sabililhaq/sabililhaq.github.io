---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_SHORT_NAME, SITE_TITLE, SKILLS, SOCIALS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description={`About ${SITE_SHORT_NAME} — backend, distributed systems, and a personal workshop.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<img class="avatar" src="/images/sabililhaq2.jpg" alt={SITE_TITLE} />
				<h3>About Me</h3>
				<p>
					Hi! I'm <strong>Muhammad Furqony Sabililhaq</strong> — usually just{' '}
					<strong>{SITE_SHORT_NAME}</strong>. I work on backend and distributed systems at{' '}
					<strong>Samsung R&amp;D Institute Indonesia</strong>. I like building products and staying
					close to the full engineering process — from the messy first version to something people
					actually use.
				</p>

				<p>
					This site is the workshop. <a href="/labs">Labs</a> are things I run on my own domain.{' '}
					<a href="/projects">Projects</a> are the ones that escaped.
				</p>

				<p>
					I studied computer science at Universitas Brawijaya. In my third year I joined{' '}
					<a href="https://grow.google/intl/id_id/bangkit/" target="_blank" rel="noopener noreferrer">
						Google Bangkit Academy
					</a>{' '}
					as an ML trainee — with the Indonesian Ministry of Education, Google, GoTo, and Traveloka —
					and interned on{' '}
					<a
						href="https://github.com/capstone-bangkit-c22-ky01"
						target="_blank"
						rel="noopener noreferrer"
					>
						TravelokaOCR
					</a>
					, a KTP-scanning capstone hosted by Traveloka. I still enjoy competitive programming.
				</p>

				<p>
					I care about backend systems, and about tools that only make sense from here — Indonesian
					language, local products, WhatsApp-shaped software.
				</p>

				<h2>Skills</h2>
				<div class="skills">
					{
						SKILLS.map((group) => (
							<div class="skill-group">
								<h3>{group.label}</h3>
								<p class="skill-list">{group.items.join(' · ')}</p>
							</div>
						))
					}
				</div>

				<h2>Find me</h2>
				<ul>
					<li><a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
					<li><a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
					<li><a href={SOCIALS.medium} target="_blank" rel="noopener noreferrer">Medium</a></li>
					<li><a href={SOCIALS.email}>Email</a></li>
				</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose h1 {
		margin-bottom: 1rem;
	}
	.prose h2 {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		font-size: 1.35rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.skill-group h3 {
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: rgb(var(--gray));
		margin-bottom: 0.35rem;
	}

	.skill-list {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
	}

	.avatar {
		width: 120px;
		height: 120px;
		object-fit: cover;
		border-radius: 0.75rem;
		margin-bottom: 1.5rem;
		display: block;
	}
</style>
