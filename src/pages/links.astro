---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, SITE_SHORT_NAME, SITE_TITLE, SOCIALS } from '../consts';

const siteLinks = [
	{ label: 'About', url: '/about', description: 'Who I am' },
	{ label: 'Projects', url: '/projects', description: 'Things that escaped the workshop' },
	{ label: 'Blog', url: '/blog', description: 'Writing, including earlier pieces on Medium' },
	{ label: 'Labs', url: '/labs', description: 'Things I run for myself' },
];

const elsewhere = [
	{ label: 'GitHub', url: SOCIALS.github, description: 'Open source projects and code' },
	{ label: 'LinkedIn', url: SOCIALS.linkedin, description: 'Professional profile' },
	{ label: 'Email', url: SOCIALS.email, description: EMAIL },
	{ label: 'LeetCode', url: SOCIALS.leetcode, description: 'Programming' },
	{ label: 'HackerRank', url: SOCIALS.hackerrank, description: 'Programming' },
	{ label: 'Medium', url: SOCIALS.medium, description: 'Older writing' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Links | ${SITE_TITLE}`}
			description={`Links and social profiles for ${SITE_SHORT_NAME}.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h3>Links</h3>
				<p class="intro">On this site, and around the web.</p>

				<h2>This site</h2>
				<ul class="link-list">
					{
						siteLinks.map((link) => (
							<li>
								<a href={link.url}>{link.label}</a>
								{link.description && <span class="desc"> — {link.description}</span>}
							</li>
						))
					}
				</ul>

				<h2>Elsewhere</h2>
				<ul class="link-list">
					{
						elsewhere.map((link) => (
							<li>
								<a
									href={link.url}
									target={link.url.startsWith('mailto') ? undefined : '_blank'}
									rel={link.url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
								>
									{link.label}
								</a>
								{link.description && <span class="desc"> — {link.description}</span>}
							</li>
						))
					}
				</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose h1 {
		margin-bottom: 1.5rem;
	}
	.intro {
		margin: 0 0 1.5rem;
		color: rgb(var(--gray));
		font-size: 1rem;
	}
	.prose h2 {
		margin-top: 2rem;
		margin-bottom: 1rem;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: rgb(var(--gray));
		padding-bottom: 0.4rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.link-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.link-list li {
		position: relative;
		isolation: isolate;
		font-size: 1rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 0.85rem;
	}
	.link-list li:last-child {
		border-bottom: none;
	}
	.link-list li::before {
		content: "";
		position: absolute;
		z-index: -1;
		inset: 0 0 0.85rem;
		background-color: rgb(var(--row-hover));
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}
	.link-list li:hover::before {
		opacity: 1;
	}
	.link-list a {
		font-weight: 600;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.link-list a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.link-list a:hover {
		text-decoration: underline;
		color: var(--accent);
	}
	.desc {
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
</style>
