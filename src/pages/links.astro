---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, SITE_SHORT_NAME, SITE_TITLE, SOCIALS } from '../consts';

const siteLinks = [
	{ label: 'About', url: '/about', description: 'Who I am' },
	{ label: 'Projects', url: '/projects', description: 'Things that escaped the workshop' },
	{ label: 'Blog', url: '/blog', description: 'Writing, including earlier pieces on Medium' },
	{ label: 'Labs', url: '/labs', description: 'Things I run for myself' },
];

const elsewhere = [
	{ label: 'GitHub', url: SOCIALS.github, description: 'Open source projects and code' },
	{ label: 'LinkedIn', url: SOCIALS.linkedin, description: 'Professional profile' },
	{ label: 'Email', url: SOCIALS.email, description: EMAIL },
	{ label: 'LeetCode', url: SOCIALS.leetcode, description: 'Programming' },
	{ label: 'HackerRank', url: SOCIALS.hackerrank, description: 'Programming' },
	{ label: 'Medium', url: SOCIALS.medium, description: 'Older writing' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Links | ${SITE_TITLE}`}
			description={`Links and social profiles for ${SITE_SHORT_NAME}.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<h1 class="page-title">Links</h1>

				<h2>This site</h2>
				<ul class="link-list hover-list">
					{
						siteLinks.map((link) => (
							<li>
								<a href={link.url}>{link.label}</a>
								{link.description && <span class="desc"> — {link.description}</span>}
							</li>
						))
					}
				</ul>

				<h2>Elsewhere</h2>
				<ul class="link-list hover-list">
					{
						elsewhere.map((link) => (
							<li>
								<a
									href={link.url}
									target={link.url.startsWith('mailto') ? undefined : '_blank'}
									rel={link.url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
								>
									{link.label}
								</a>
								{link.description && <span class="desc"> — {link.description}</span>}
							</li>
						))
					}
				</ul>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	h2 {
		margin-top: 2rem;
		margin-bottom: 1rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: rgb(var(--black));
		padding-top: 0.25rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	h1 + h2 {
		margin-top: 0;
		border-top: none;
		padding-top: 0;
	}
	.link-list {
		margin-bottom: 0.5rem;
	}
	.link-list li {
		line-height: 1.5;
	}
	.link-list a {
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		box-shadow: 0 1px 0 0 currentColor;
	}
	.link-list a:hover,
	.link-list a:active {
		box-shadow: none;
	}
	.desc {
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
</style>
