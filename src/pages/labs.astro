---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { LABS, LAB_GROUPS, SITE_SHORT_NAME, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Labs | ${SITE_TITLE}`}
      description={`Labs and playgrounds by ${SITE_SHORT_NAME}.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <article>
        <h1 class="page-title">Labs</h1>
        {LAB_GROUPS.map((group) => (
          <section class="lab-group">
            <h2>{group}</h2>
        <ul class="link-list hover-list">
          {
            LABS.filter((lab) => lab.group === group).map((lab) => (
              <li>
                <a
                  href={lab.url}
                  target={lab.url.startsWith('http') ? '_blank' : undefined}
                  rel={lab.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {lab.label}
                </a>
                {lab.note && <span class="note">{lab.note}</span>}
                {lab.description && (
                  <p class="desc">{lab.description}</p>
                )}
              </li>
            ))
          }
        </ul>
          </section>
        ))}
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .lab-group { margin-bottom: 2rem; }
  .lab-group h2 { font-size: 1.05rem; margin-bottom: 0.75rem; }
  .link-list a {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--accent);
    text-decoration: none;
    box-shadow: 0 1px 0 0 currentColor;
  }
  .link-list a:hover,
  .link-list a:active {
    box-shadow: none;
  }
  .note {
    color: rgb(var(--gray));
    font-size: 0.85rem;
    margin-left: 0.65rem;
  }
  .desc {
    color: rgb(var(--gray));
    font-size: 0.95rem;
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }
</style>
