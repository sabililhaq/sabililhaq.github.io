---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_SHORT_NAME, SITE_TITLE } from '../consts';

const labs = [
  {
    label: 'Chat',
    url: '/chat',
    description: 'Anonymous, temporary chat',
  },
  {
    label: 'Files',
    url: 'https://files.sabililhaq.com',
    description: 'My public read only file system',
  },
  {
    label: 'Excalidraw',
    url: 'https://draw.sabililhaq.com', // TODO configurable
    description: 'Whiteboard playground',
  },
  {
    label: 'URL Shortener',
    url: 'https://go.sabililhaq.com',
    description: 'Personal URL shortener',
  },
  {
    label: 'QR Code Generator',
    url: '/qr',
    description: 'Generate QR codes instantly from URL',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Labs | ${SITE_TITLE}`}
      description={`Labs and playgrounds by ${SITE_SHORT_NAME}.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <article class="prose">
        <h3>Labs</h3>
        <p class="intro">Personal playgrounds.</p>
        <ul class="link-list">
          {
            labs.map((lab) => (
              <li>
                <a
                  href={lab.url}
                  target={lab.url.startsWith('http') ? '_blank' : undefined}
                  rel={lab.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {lab.label}
                </a>
                {lab.description && (
                  <span class="desc"> — {lab.description}</span>
                )}
              </li>
            ))
          }
        </ul>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .prose h1 {
    margin-bottom: 0.5rem;
  }
  .intro {
    margin: 0 0 1.5rem;
    color: rgb(var(--gray));
    font-size: 1rem;
  }
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .link-list li {
    font-size: 1rem;
    border-bottom: 1px solid rgb(var(--gray-light));
    padding-bottom: 0.85rem;
  }
  .link-list li:last-child {
    border-bottom: none;
  }
  .link-list a {
    font-weight: 600;
    color: rgb(var(--black));
    text-decoration: none;
  }
  .link-list a:hover {
    text-decoration: underline;
    color: var(--accent);
  }
  .desc {
    color: rgb(var(--gray));
    font-size: 0.9rem;
  }
</style>
