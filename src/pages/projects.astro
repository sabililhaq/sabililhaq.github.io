---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PROJECT_GROUPS, PROJECTS, SITE_SHORT_NAME, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Projects | ${SITE_TITLE}`}
      description={`Selected projects by ${SITE_SHORT_NAME}.`}
    />
  </head>
  <body>
    <Header />
    <main>
      <article class="prose">
        <h1 class="page-title">Projects</h1>

        {
          PROJECT_GROUPS.map((group) => {
            const items = PROJECTS.filter((project) => project.group === group.id);
            if (items.length === 0) return null;

            return (
              <section class="group">
                <h2>{group.label}</h2>
                <div class="projects">
                  {items.map((project) => (
                    <div class="project" id={project.id}>
                      <div class="project-header">
                        <h3>{project.title}</h3>
                        <div class="project-links">
                          {project.liveDemo && (
                            <a
                              href={project.liveDemo}
                              target={project.liveDemo.startsWith('http') ? '_blank' : undefined}
                              rel={project.liveDemo.startsWith('http') ? 'noopener noreferrer' : undefined}
                            >
                              {project.liveDemo.startsWith('http') ? 'Live Demo ↗' : 'Open'}
                            </a>
                          )}
                          {project.sourceCode && (
                            <a href={project.sourceCode} target="_blank" rel="noopener noreferrer">
                              Source ↗
                            </a>
                          )}
                          {project.roadmap && (
                            <a href={project.roadmap}>
                              Roadmap
                            </a>
                          )}
                        </div>
                      </div>
                      {project.image && (
                        <img
                          class="project-still"
                          src={project.image}
                          alt={project.imageAlt ?? ''}
                        />
                      )}
                      {project.overview.map((para) => (
                        <p set:html={para} />
                      ))}
                      <p class="tech-stack">{project.techStack}</p>
                    </div>
                  ))}
                </div>
              </section>
            );
          })
        }
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .group {
    margin-bottom: 2.5rem;
  }

  .group h2 {
    font-size: 1.05rem;
    font-weight: 700;
    color: rgb(var(--black));
    margin: 0 0 1.15rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgb(var(--gray-light));
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .project {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgb(var(--gray-light));
  }

  .project:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .project-still {
    display: block;
    width: 100%;
    margin: 0.75rem 0 1rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 4px;
  }

  .project h3 {
    font-size: 1.15rem;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .project-links a {
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
  }

  .project-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .project p {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: rgb(var(--gray-dark));
  }

  .tech-stack {
    font-size: 0.85rem !important;
    color: rgb(var(--gray)) !important;
  }

  @media (max-width: 640px) {
    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .project-links {
      gap: 0.5rem;
    }
  }
</style>
