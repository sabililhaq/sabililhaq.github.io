---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Vim Dojo Roadmap | ${SITE_TITLE}`}
      description="Learning plan for Vim Dojo: categorized practice, random review, a daily kata, and interactive hints."
    />
  </head>
  <body>
    <Header />
    <main>
      <article class="prose">
        <p class="back">
          <a href="/vim">← Vim Dojo</a>
        </p>
        <h1 class="page-title">Vim Dojo roadmap</h1>
        <p class="intro">
          A learning tool that builds muscle memory. Not a beginner tutorial.
          You should already know Normal mode. The dojo then makes that knowledge
          automatic.
        </p>
        <p class="intro">
          No accounts. No leaderboards. No skill trees.
        </p>
        <p class="intro">
          Category play, random review, and a daily kata are in the dojo.
          Interactive hints are next: teach in the buffer, starting with a
          target highlight and then ghosting the next intended key.
        </p>
        <p class="source">
          The long form lives in the{' '}
          <a href="https://github.com/sabililhaq/vim-dojo/blob/main/ROADMAP.md" target="_blank" rel="noopener noreferrer">vim-dojo repo</a>.
        </p>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .back {
    margin: 0 0 1rem;
    font-size: 0.85rem;
  }

  .back a {
    color: var(--accent);
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
  }

  .intro {
    margin: 0 0 1rem;
    color: rgb(var(--gray));
    font-size: 1rem;
  }

  .source {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: rgb(var(--gray));
  }

  .source a {
    color: var(--accent);
    text-decoration: none;
  }

  .source a:hover {
    text-decoration: underline;
  }
</style>
