---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/chat/ChatWidget.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
    <BaseHead title={`Chat | ${SITE_TITLE}`} description="Simple, anonymous, temporary chat over WebSocket" />
    <style>
        .chat-page {
            max-width: 720px;
            margin: 0 auto;
            padding: 2rem 1.25rem 1rem;
        }
        .chat-page h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
            line-height: 1.2;
            color: rgb(var(--black));
        }
    </style>
</head>
<body>
    <Header />
    <main class="chat-page">
        <h1>Chat</h1>
        <ChatWidget />
    </main>
    <Footer />
</body>
</html>
