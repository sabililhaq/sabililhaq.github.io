---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QRGenerator from '../components/qr/QRGenerator.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`QR Code Generator | ${SITE_TITLE}`} description="Free online QR Code Generator" />
    <style>
      .note {
        color: rgb(var(--gray));
        margin: -0.75rem 0 1.75rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-title">QR Code Generator</h1>
      <p class="note">No data is sent to any server.</p>
      
      <QRGenerator />
    </main>
    <Footer />
  </body>
</html>
