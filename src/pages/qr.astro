---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QRGenerator from '../components/qr/QRGenerator.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`QR Code Generator | ${SITE_TITLE}`} description="Free online QR Code Generator" />
    <style>
      .qr-page {
        max-width: 720px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem;
      }
      .qr-page h1 {
        font-size: 1.875rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }
      .qr-page .subtitle {
        color: #666;
        margin-bottom: 2rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="qr-page">
      <h1>QR Code Generator</h1>
      <p class="subtitle">Generate QR codes instantly. No data is sent to any server.</p>
      
      <QRGenerator client:load />
    </main>
    <Footer />
  </body>
</html>
