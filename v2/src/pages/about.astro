---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, SITE_SHORT_NAME, SITE_TITLE, SOCIALS } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description={`About ${SITE_SHORT_NAME} — software engineering, data, and machine learning.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h1>About Me</h1>
				<p>
					Hi! I'm <strong>Muhammad Furqony Sabililhaq</strong> — usually just{' '}
					<strong>{SITE_SHORT_NAME}</strong>. I'm a computer science graduate with a deep interest in
					Software Engineering and Data fields. I'm passionate about coding, enjoy competitive
					programming, and occasionally write about tech.
				</p>

				<p>
					My focus areas include <strong>Backend Engineering</strong>,{' '}
					<strong>Data Analysis</strong>, and <strong>Machine Learning</strong> (Deep Learning with
					emphasis on Computer Vision and NLP). I've worked on software development and data science
					projects in academic and industry settings.
				</p>

				<p>
					During my third year of college, I joined{' '}
					<a href="https://grow.google/intl/id_id/bangkit/" target="_blank" rel="noopener noreferrer">
						Google Bangkit Academy
					</a>{' '}
					as a Machine Learning Engineer trainee — an intensive program run with the Indonesian Ministry
					of Education and Culture, Google, GoTo, and Traveloka. I later interned at{' '}
					<strong>Traveloka</strong> on a{' '}
					<a
						href="https://github.com/capstone-bangkit-c22-ky01"
						target="_blank"
						rel="noopener noreferrer"
					>
						company-based capstone project
					</a>{' '}
					(TravelokaOCR) as a Machine Learning Engineer.
				</p>

				<p>
					I'm enthusiastic about technology, especially artificial intelligence and human space
					exploration. I'm also an active member of{' '}
					<a
						href="https://www.linkedin.com/company/bccfilkomub/"
						target="_blank"
						rel="noopener noreferrer"
					>
						BCC (Basic Computing Community)
					</a>.
				</p>

				<h2>Find me online</h2>
				<ul>
					<li>
						<a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
					</li>
					<li>
						<a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
					</li>
					<li>
						<a href={SOCIALS.medium} target="_blank" rel="noopener noreferrer">Medium</a>
					</li>
					<li>
						<a href={SOCIALS.leetcode} target="_blank" rel="noopener noreferrer">LeetCode</a>
					</li>
					<li>
						<a href={SOCIALS.hackerrank} target="_blank" rel="noopener noreferrer">HackerRank</a>
					</li>
					<li>
						<a href={SOCIALS.email}>{EMAIL}</a>
					</li>
				</ul>

				<p>
					Or jump to the <a href="/#projects">projects</a>, <a href="/#skills">skills</a>, or
					<a href="/#contact">contact</a> sections on the home page.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.prose h1 {
		margin-bottom: 1rem;
	}
	.prose h2 {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
	}
</style>
