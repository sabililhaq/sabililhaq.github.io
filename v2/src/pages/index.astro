---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	CONTACT_FORM_URL,
	PROJECTS,
	SITE_DESCRIPTION,
	SITE_SHORT_NAME,
	SITE_TITLE,
	SKILLS,
	SOCIALS,
} from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- Hero / About -->
			<section class="hero" id="about">
				<div class="hero-photo">
					<img src="/images/sabililhaq2.jpg" alt={SITE_TITLE} width="320" height="320" />
					<div class="hero-socials">
						<a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" title="LinkedIn">
							<img src="/images/skills/linkedin-icon.svg" width="36" height="36" alt="LinkedIn" />
						</a>
						<a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" title="GitHub">
							<img src="/images/skills/github-icon.svg" width="36" height="36" alt="GitHub" />
						</a>
						<a href={SOCIALS.medium} target="_blank" rel="noopener noreferrer" title="Medium">
							<img src="/images/skills/medium.svg" width="36" height="36" alt="Medium" />
						</a>
						<a href={SOCIALS.email} title="Email">
							<img src="/images/skills/email-icon.svg" width="36" height="36" alt="Email" />
						</a>
					</div>
				</div>
				<div class="hero-copy">
					<h1>Hi! I'm <span class="accent">{SITE_SHORT_NAME}</span></h1>
					<p>
						Computer science graduate with deep interest in Software Engineering and Data fields.
						Very passionate about coding and enjoys competitive programming. Sometimes writes
						tech-related stuff.
					</p>
					<p>
						Currently focused on <strong>Backend Engineering</strong>, <strong>Data Analysis</strong>,
						and <strong>Machine Learning</strong> (Deep Learning with a focus on <strong>CV</strong> and
						<strong>NLP</strong>). Prior experience working on software development and data science
						projects.
					</p>
					<p>
						In the third year of college, I was selected for
						<a href="https://grow.google/intl/id_id/bangkit/" target="_blank" rel="noopener noreferrer"
							><strong>Google Bangkit Academy</strong></a
						>, an intensive technology apprenticeship initiated by the
						<a href="https://www.kemdikbud.go.id" target="_blank" rel="noopener noreferrer"
							>Indonesian Ministry of Education and Culture</a
						>, Google, GoTo, and Traveloka as a Machine Learning Engineer trainee. I also interned at
						<strong>Traveloka</strong>, working on a
						<a
							href="https://github.com/capstone-bangkit-c22-ky01"
							target="_blank"
							rel="noopener noreferrer">company-based Capstone Project</a
						>
						as a Machine Learning Engineer.
					</p>
					<p>
						Enthusiastic about technology — especially artificial intelligence and human space
						exploration. Active member of the tech community
						<a
							href="https://www.linkedin.com/company/bccfilkomub/"
							target="_blank"
							rel="noopener noreferrer"><strong>BCC</strong></a
						>.
					</p>
					<div class="hero-actions">
						<a class="btn" href="#projects">Projects</a>
						<a class="btn btn-outline" href="/about">About</a>
					</div>
				</div>
			</section>

			<!-- Projects -->
			<section id="projects">
				<h2>Projects</h2>
				{
					PROJECTS.map((project) => (
						<article class="project" id={project.id}>
							<div class="project-body">
								<h3>{project.title}</h3>
								<p class="label">Overview</p>
								{project.overview.map((para) => (
									<p>{para}</p>
								))}
								<p class="label">Tech Stack</p>
								<p>{project.techStack}</p>
								<div class="project-actions">
									{project.liveDemo && (
										<a class="btn btn-outline" href={project.liveDemo} target="_blank" rel="noopener noreferrer">
											Live Demo
										</a>
									)}
									{project.sourceCode && (
										<a class="btn" href={project.sourceCode} target="_blank" rel="noopener noreferrer">
											Source Code
										</a>
									)}
								</div>
							</div>
							<div class="project-media">
								<img src={project.image} alt={project.imageAlt} loading="lazy" />
							</div>
						</article>
					))
				}
			</section>

			<!-- Skills -->
			<section id="skills">
				<h2>Technical Skills</h2>
				{
					SKILLS.map((group) => (
						<div class="skill-group">
							<h3>{group.label}</h3>
							<ul class="skill-list">
								{group.items.map((skill) => (
									<li>
										<img src={skill.icon} alt="" width="40" height="40" />
										<span>{skill.name}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</section>

			<!-- Contact -->
			<section id="contact">
				<h2>Contact</h2>
				<div class="contact-grid">
					<form class="contact-form" name="contact-form" id="contact-form">
						<label for="nama">
							Full Name
							<input type="text" id="nama" name="nama" required />
						</label>
						<label for="email">
							Email
							<input type="email" id="email" name="email" placeholder="you@email.com" required />
						</label>
						<label for="pesan">
							Message
							<textarea id="pesan" name="pesan" rows="5" required></textarea>
						</label>
						<button type="submit" class="btn">Send</button>
						<p class="form-status" id="form-status" hidden></p>
					</form>
					<div class="contact-photo">
						<img src="/images/sabililhaq.jpg" alt={SITE_TITLE} width="280" height="280" loading="lazy" />
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script define:vars={{ CONTACT_FORM_URL }}>
			const form = document.forms.namedItem('contact-form');
			const statusEl = document.getElementById('form-status');

			form?.addEventListener('submit', async (e) => {
				e.preventDefault();
				if (!form || !statusEl) return;

				statusEl.hidden = false;
				statusEl.textContent = 'Sending…';

				try {
					await fetch(CONTACT_FORM_URL, {
						method: 'POST',
						body: new FormData(form),
					});
					statusEl.textContent = 'Successfully sent the message. Thank you!';
					form.reset();
				} catch (err) {
					statusEl.textContent = 'Something went wrong. Please try email instead.';
					console.error(err);
				}
			});
		</script>
	</body>
</html>

<style>
	.home {
		width: 960px;
		max-width: calc(100% - 2em);
	}

	.accent {
		color: var(--accent);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(200px, 280px) 1fr;
		gap: 2.5rem;
		align-items: start;
		margin-bottom: 4rem;
	}

	.hero-photo img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 1.25rem;
		box-shadow: var(--box-shadow);
	}

	.hero-socials {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 1.25rem;
	}

	.hero-socials a:hover {
		opacity: 0.75;
	}

	.hero-socials img,
	.skill-list img,
	.project-media img {
		border-radius: 0;
	}

	.hero-copy h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.hero-actions,
	.project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.btn {
		display: inline-block;
		padding: 0.6rem 1.25rem;
		border-radius: 0.75rem;
		background: var(--accent);
		color: white;
		font-weight: 700;
		text-decoration: none;
		border: 2px solid var(--accent);
		cursor: pointer;
		font-size: 1rem;
		font-family: inherit;
	}

	.btn:hover {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		color: white;
	}

	.btn-outline {
		background: transparent;
		color: rgb(var(--black));
		border-color: rgb(var(--black));
	}

	.btn-outline:hover {
		background: rgb(var(--black));
		color: white;
		border-color: rgb(var(--black));
	}

	section {
		margin-bottom: 4rem;
		scroll-margin-top: 5rem;
	}

	section > h2 {
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid rgb(var(--gray-light));
	}

	.project {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 2rem;
		align-items: center;
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.project:last-child {
		border-bottom: none;
	}

	.project h3 {
		margin-bottom: 0.75rem;
		text-decoration: underline;
		text-decoration-color: rgb(var(--gray));
		text-underline-offset: 0.25em;
	}

	.label {
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 0.35rem;
		margin-top: 1rem;
	}

	.project-media img {
		width: 100%;
		border-radius: 1rem;
		box-shadow: var(--box-shadow);
		object-fit: cover;
	}

	.skill-group {
		margin-bottom: 2rem;
	}

	.skill-group h3 {
		color: var(--accent);
		font-size: 1.25rem;
		margin-bottom: 1rem;
	}

	.skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.skill-list li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		min-width: 4.5rem;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.skill-list img {
		width: 40px;
		height: 40px;
		object-fit: contain;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 2rem;
		align-items: start;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.contact-form label {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-weight: 700;
		font-size: 0.95rem;
	}

	.contact-form input,
	.contact-form textarea {
		font-family: inherit;
		padding: 0.75rem 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 0.5rem;
		background: white;
		color: rgb(var(--gray-dark));
	}

	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.contact-form .btn {
		align-self: flex-start;
		margin-top: 0.5rem;
	}

	.form-status {
		margin: 0;
		font-size: 0.95rem;
		color: rgb(var(--gray));
	}

	.contact-photo img {
		width: 100%;
		max-width: 280px;
		margin: 0 auto;
		display: block;
		border-radius: 1.25rem;
		box-shadow: var(--box-shadow);
		object-fit: cover;
	}

	@media (max-width: 720px) {
		.hero,
		.project,
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.hero-photo {
			max-width: 240px;
			margin: 0 auto;
		}

		.hero-copy h1 {
			font-size: 2rem;
			text-align: center;
		}

		.hero-actions {
			justify-content: center;
		}

		.contact-photo {
			order: -1;
		}
	}
</style>
